# J.A.R.V.I.S. Configuration Example

# Server Network Settings
PORT=4001
HOST=0.0.0.0

# Storage & Sandboxing
JARVIS_WORKSPACE_DIR=/Users/chaudhryyousaf/Desktop/AiProjects/jarvis/workspace
JARVIS_DB_PATH=/Users/chaudhryyousaf/Desktop/AiProjects/jarvis/server/jarvis.sqlite

# AI Provider Configuration
# Options: builtin (zero-dependency, rule-based & heuristic), openai, gemini, anthropic
AI_PROVIDER=builtin
AI_MODEL=default

# Optional External API Keys (Leave blank to use the Built-in Engine)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
