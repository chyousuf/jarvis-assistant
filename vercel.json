{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "cd client && npm install && npm run build",
  "outputDirectory": "client/dist",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/ai/:match*",
      "destination": "/api/ai"
    },
    {
      "source": "/api/auth/:match*",
      "destination": "/api/auth"
    },
    {
      "source": "/api/chat/:match*",
      "destination": "/api/chat"
    },
    {
      "source": "/api/learning/:match*",
      "destination": "/api/learning"
    },
    {
      "source": "/api/emails/:match*",
      "destination": "/api/emails"
    },
    {
      "source": "/api/calendar/:match*",
      "destination": "/api/calendar"
    },
    {
      "source": "/api/whatsapp/:match*",
      "destination": "/api/whatsapp"
    },
    {
      "source": "/api/contacts/:match*",
      "destination": "/api/contacts"
    },
    {
      "source": "/api/memory/:match*",
      "destination": "/api/memory"
    },
    {
      "source": "/api/tasks/:match*",
      "destination": "/api/tasks"
    },
    {
      "source": "/api/files/:match*",
      "destination": "/api/files"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
